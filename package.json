{
  "name": "interneto-project",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "db:init": "node scripts/db/init.js",
    "db:import": "node scripts/db/import.js",
    "db:validate": "node scripts/db/validate.js",
    "db:export": "node scripts/db/export-markdown.js && node scripts/db/export-json.js",
    "db:test": "node --test \"scripts/db/**/*.test.js\"",
    "sync": "node scripts/db/import.js && node scripts/db/validate.js && node scripts/db/export-markdown.js && node scripts/db/export-json.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.3.4",
    "d3": "^7.9.0",
    "fuzzysort": "^4.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.9.5",
    "playwright": "^1.61.1",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3"
  }
}
