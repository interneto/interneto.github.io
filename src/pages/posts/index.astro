---
import { getCollection } from 'astro:content';
import VPLayout from '../../layouts/VPLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cleanSlug = (id: string) => id.replace(/\.md$/i, '');

type SectionName = 'Comparing' | 'How-To' | 'Articles' | 'Philosophy';

const sectionBySlug: Record<string, SectionName> = {
  'ai-coding-tools': 'Comparing',
  'bookmark-managers': 'Comparing',
  'linux-distros': 'Comparing',
  'how-to-categorize-links': 'How-To',
  'file-sync': 'How-To',
  'cybersecurity-vulnerabilities': 'Articles',
  'history-of-computing': 'Articles',
  'os-layer-stack': 'Articles',
  'good-software-manifesto': 'Articles',
  'what-is-info': 'Articles',
  'turing-complete-reality': 'Philosophy',
};

const sectionIcons: Record<SectionName, string> = {
  'Comparing': '📊',
  'How-To': '📝',
  'Articles': '📄',
  'Philosophy': '🤔',
};

const sectionOrder: SectionName[] = ['Comparing', 'How-To', 'Articles', 'Philosophy'];

const posts = (await getCollection('posts'))
  .filter((entry) => cleanSlug(entry.id) !== 'index')
  .sort((a, b) => a.id.localeCompare(b.id));

const groupedPosts = sectionOrder.map((section) => ({
  section,
  items: posts.filter((entry) => (sectionBySlug[cleanSlug(entry.id)] ?? 'Articles') === section),
}));

const allTags = Array.from(
  new Set(posts.flatMap((entry) => entry.data.tags ?? []))
).sort();
---

<VPLayout title="📑 Posts" hasSidebar={true} extraStyles={['styles/content-shared.css']}>
  <div class="vp-content-wrapper">
    <header class="vp-content-header">
      <h1>Posts</h1>
      <p class="vp-content-subtitle">Curated articles, guides, and insights about internet tools and organization.</p>
    </header>

    {allTags.length > 0 && (
      <div class="vp-content-tagbar" role="group" aria-label="Filter by tag">
        <span class="vp-content-tagbar-label">Tags:</span>
        <button type="button" class="vp-tag-filter is-active" data-tag-filter="">All</button>
        {allTags.map((tag) => (
          <button type="button" class="vp-tag-filter" data-tag-filter={tag}>{tag}</button>
        ))}
      </div>
    )}

    {groupedPosts.map((group) => (
      <section class="vp-content-section" data-section={group.section} aria-label={`${group.section} posts`}>
        <h2 class="vp-content-section-title">{group.section}</h2>
        <div class="vp-content-grid">
          {group.items.map((entry) => (
            <ContentCard
              href={`${BASE}post/${cleanSlug(entry.id)}/`}
              title={entry.data.title ?? cleanSlug(entry.id)}
              description={entry.data.description}
              icon={sectionIcons[group.section]}
              tags={entry.data.tags ?? []}
            />
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('.vp-content-card[data-tags]'));
      const sections = Array.from(document.querySelectorAll('.vp-content-section[data-section]'));
      const tagButtons = Array.from(document.querySelectorAll('.vp-tag-filter'));
      const searchInput = document.getElementById('postsSidebarSearch');

      let activeTag = '';
      let activeQuery = '';

      const normalize = (v) => v.trim().toLowerCase();

      const apply = () => {
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const title = normalize(card.querySelector('.vp-content-card-title')?.textContent || '');
          const desc = normalize(card.querySelector('.vp-content-card-description')?.textContent || '');
          const tagText = tags.join(' ').toLowerCase();
          const matchesTag = !activeTag || tags.includes(activeTag);
          const matchesQuery = !activeQuery || title.includes(activeQuery) || desc.includes(activeQuery) || tagText.includes(activeQuery);
          card.classList.toggle('vp-tag-hidden', !matchesTag);
          card.classList.toggle('vp-search-hidden', !matchesQuery);
        });
        sections.forEach((section) => {
          const visible = Array.from(section.querySelectorAll('.vp-content-card'))
            .some((c) => !c.classList.contains('vp-tag-hidden') && !c.classList.contains('vp-search-hidden'));
          section.classList.toggle('vp-tag-hidden', !visible);
        });
      };

      tagButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTag = btn.getAttribute('data-tag-filter') || '';
          tagButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
          apply();
        });
      });

      if (searchInput instanceof HTMLInputElement) {
        searchInput.addEventListener('input', () => {
          activeQuery = normalize(searchInput.value);
          apply();
        });
      }
    })();
  </script>
</VPLayout>
