---
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
const options = [
  { value: 'exportPackages', label: '📤 Export Extensions (JSON)' },
];
---
<ToolboxInstallerSection
  title="Browser Extensions Installer"
  heading="Browser Extensions Installer"
  info="Browse curated extensions for Firefox and Chromium. Filter by browser, select what you need, and export your list. Direct .crx/.xpi mode links straight to the package file — useful for sideloading (e.g. Ungoogled Chromium, which has no Web Store) instead of opening the store page."
  searchPlaceholder="Search by extension name"
  options={options}
  showFileInput={false}
  commandLabel="Extension links:"
  commandInitialText="Select extensions to generate install links..."
>
  <div slot="selectors" class="os-selector-container">
    <div class="primary-os-selector">
      <button type="button" class="os-btn active" data-browser="firefox">🦊 Firefox</button>
      <button type="button" class="os-btn" data-browser="chromium">🔵 Chromium</button>
      <button type="button" class="os-btn" data-browser="both">🔀 Both</button>
    </div>
    <div class="secondary-os-selector">
      <button type="button" class="os-btn" id="directDownloadToggle" title="Link directly to the .crx/.xpi package file instead of the store page — for sideloading">📦 Direct .crx/.xpi</button>
    </div>
  </div>

  <ToolboxResultsContainer slot="content" id="browserExtensionsCategories" />

</ToolboxInstallerSection>

<script>
import '../../scripts/toolbox-installer/packages-table.ts';
</script>
