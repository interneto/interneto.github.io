---
import VPLayout from '../../layouts/VPLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlatformNav from '../../components/PlatformNav.astro';
import PlatformViewToggle from '../../components/PlatformViewToggle.astro';
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
import CompatibilityTablePage from '../../components/CompatibilityTablePage.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options = [
  { value: 'exportPackages', label: '📤 Export Extensions (JSON)' },
];
---
<VPLayout title="Browser Extensions Installer" hasSidebar={false} extraStyles={['styles/generator.css', 'styles/os-compatibility.css']}>
  <div class="page-wrapper installer-page-wrapper">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}toolbox/`}>Toolbox</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Browser Extensions Installer</span>
    </nav>
    <PageHeader heading="Browser Extensions Installer" />
    <PlatformNav current="browser" />
    <PlatformViewToggle compatLabel="Compatibility Table" />

    <div id="installerView">
      <ToolboxInstallerSection
        bare
        title="Browser Extensions Installer"
        heading="Browser Extensions Installer"
        info="Browse curated extensions for Firefox and Chromium. Filter by browser, select what you need, and export your list. Direct .crx/.xpi mode links straight to the package file — useful for sideloading (e.g. Ungoogled Chromium, which has no Web Store) instead of opening the store page."
        searchPlaceholder="Search by extension name"
        options={options}
        showFileInput={false}
        commandLabel="Extension links:"
        commandInitialText="Select extensions to generate install links..."
      >
        <div slot="selectors" class="os-selector-container">
          <div class="primary-os-selector">
            <button type="button" class="os-btn active" data-browser="firefox">🦊 Firefox</button>
            <button type="button" class="os-btn" data-browser="chromium">🔵 Chromium</button>
            <button type="button" class="os-btn" data-browser="both">🔀 Both</button>
          </div>
          <div class="secondary-os-selector">
            <button type="button" class="os-btn" id="directDownloadToggle" title="Link directly to the .crx/.xpi package file instead of the store page — for sideloading">📦 Direct .crx/.xpi</button>
          </div>
        </div>

        <ToolboxResultsContainer slot="content" id="browserExtensionsCategories" />
      </ToolboxInstallerSection>
    </div>

    <div id="compatView" hidden>
      <CompatibilityTablePage
        bare
        title="Browser Extensions Table"
        heading="🧩 Browser Extensions Compatibility"
        subtitle="Extension list and store links for Firefox and Chromium-based browsers."
        installerHref="browser"
        installerLabel="Go to Installer"
        searchPlaceholder="Search extension name, id, or category"
        showFilterChips={true}
        filterAriaLabel="Filter by category"
      >
        <div class="table-container">
          <table id="packagesTable">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>
        <div class="stats" id="statsContainer"></div>
      </CompatibilityTablePage>
    </div>
  </div>
</VPLayout>

<script>
import '../../scripts/toolbox-installer/packages-table.ts';
import '../../scripts/os-compat/software-table-pages.ts';
import '../../scripts/shared/view-toggle.ts';
</script>
