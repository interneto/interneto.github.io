---
import VPLayout from '../../layouts/VPLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlatformViewToggle from '../../components/PlatformViewToggle.astro';
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
import CompatibilityTablePage from '../../components/CompatibilityTablePage.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options = [
  { value: 'loadFavorites', label: '✨ My Favorites' },
  { value: 'importPackages', label: '📥 Import packages (JSON)' },
  { value: 'exportPackages', label: '📤 Export packages (JSON)' },
];
---
<VPLayout title="Mobile Installer" hasSidebar={false} extraStyles={['styles/generator.css', 'styles/os-compatibility.css']}>
  <div class="page-wrapper installer-page-wrapper">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}toolbox/`}>Toolbox</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Mobile Installer</span>
    </nav>
    <PageHeader heading="Mobile Installer" />
    <PlatformViewToggle compatLabel="Compatibility Table" />

    <div id="installerView">
      <ToolboxInstallerSection
        bare
        title="Mobile Installer"
        heading="Mobile Installer"
        info="Browse Android and iOS apps. Select packages and generate ADB or apt install commands for mobile platforms."
        searchPlaceholder="Search packages by name"
        options={options}
        useForm={true}
        formId="packageForm"
      >
        <div slot="selectors" class="os-selector-container">
          <div class="primary-os-selector">
            <button type="button" class="os-btn active" data-os="android"><span class="os-btn-icon" style={`--os-icon:url(${BASE}img/os/android.svg)`} aria-hidden="true"></span> Android</button>
            <button type="button" class="os-btn" data-os="ios"><span class="os-btn-icon" style={`--os-icon:url(${BASE}img/os/ios.svg)`} aria-hidden="true"></span> iOS</button>
          </div>
        </div>

        <ToolboxResultsContainer slot="content" id="packageContainer" />
      </ToolboxInstallerSection>
    </div>

    <div id="compatView" hidden>
      <CompatibilityTablePage
        bare
        title="Mobile Packages Compatibility"
        heading="📱 Mobile Packages Compatibility"
        subtitle="Availability and official store links for Android and iOS."
        installerHref="mobile"
        installerLabel="Go to Installer"
        searchPlaceholder="Search package, category, or store ID"
        showFilterChips={true}
        filterAriaLabel="Filter by mobile availability"
        pageNote="Search, sort, and filter mobile software by category and store availability."
      >
        <div class="table-container">
          <table id="packagesTable">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>
        <div class="stats" id="statsContainer"></div>
      </CompatibilityTablePage>
    </div>
  </div>
</VPLayout>

<script>
import '../../scripts/toolbox-installer/app.ts';
import '../../scripts/os-compat/software-table-pages.ts';
import '../../scripts/shared/view-toggle.ts';
</script>
