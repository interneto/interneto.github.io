---
import VPLayout from '../../layouts/VPLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlatformViewToggle from '../../components/PlatformViewToggle.astro';
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
import CompatibilityTablePage from '../../components/CompatibilityTablePage.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options = [
  { value: 'importPackages', label: '📥 Import Agents (JSON)' },
  { value: 'exportPackages', label: '📤 Export Agents (JSON)' },
];
---
<VPLayout title="AI Agents Installer" hasSidebar={false} extraStyles={['styles/generator.css', 'styles/os-compatibility.css']}>
  <div class="page-wrapper installer-page-wrapper">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}toolbox/`}>Toolbox</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">AI Agents Installer</span>
    </nav>
    <PageHeader heading="🤖 AI Agents Installer" />
    <PlatformViewToggle compatLabel="Compatibility Table" />

    <div id="installerView">
      <ToolboxInstallerSection
        bare
        title="AI Agents Installer"
        heading="🤖 AI Agents Installer"
        info="Browse MCP servers, plugins, and skills for Claude Code, Codex CLI, and other AI coding agents. Pick the tools you need and copy the ready-to-run install commands."
        searchPlaceholder="Search by name or category"
        options={options}
        showFossToggle={false}
        showFileInput={false}
        useForm={true}
        formId="agentForm"
      >
        <div slot="selectors" class="os-selector-container">
          <div class="primary-os-selector">
            <button type="button" class="os-btn active" data-agent="claude"><span class="os-btn-icon" aria-hidden="true">🤖</span> Claude Code</button>
            <button type="button" class="os-btn" data-agent="codex"><span class="os-btn-icon" aria-hidden="true">⌨️</span> Codex CLI</button>
            <button type="button" class="os-btn" data-agent="copilot"><span class="os-btn-icon" aria-hidden="true">💬</span> GitHub Copilot CLI</button>
            <button type="button" class="os-btn" data-agent="npx"><span class="os-btn-icon" aria-hidden="true">📦</span> NPX (any agent)</button>
          </div>
          <div class="page-filter-row filter-chips" role="group" aria-label="Filter by type">
            <button type="button" class="filter-chip active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="filter-chip" data-filter="mcp" aria-pressed="false">🔌 MCP Servers</button>
            <button type="button" class="filter-chip" data-filter="plugin" aria-pressed="false">🧩 Plugins / Skills</button>
          </div>
        </div>

        <div slot="content">
          <ToolboxResultsContainer
            id="packageContainer"
            showLoadingSpinner={true}
          />
        </div>
      </ToolboxInstallerSection>
    </div>

    <div id="compatView" hidden>
      <CompatibilityTablePage
        bare
        title="AI Agents Compatibility"
        heading="🤖 AI Agents Compatibility"
        subtitle="Which MCP servers, plugins, and skills work with each AI coding agent."
        installerHref="agents"
        installerLabel="Go to Installer"
        searchPlaceholder="Search tool name, type, or category"
        pageNote="Claude Code, Codex CLI, and other agents use different plugin/MCP registration methods."
      >
        <div slot="controls" class="page-filter-row filter-chips" role="group" aria-label="Filter by type">
          <button type="button" class="filter-chip active" data-os="all" aria-pressed="true">All</button>
          <button type="button" class="filter-chip" data-os="mcp" aria-pressed="false">MCP Servers</button>
          <button type="button" class="filter-chip" data-os="plugin" aria-pressed="false">Plugins / Skills</button>
        </div>

        <div slot="legend" class="legend" aria-label="Compatibility legend">
          <div class="legend-item"><span class="legend-icon">✅</span> Compatible</div>
          <div class="legend-item"><span class="legend-icon">❌</span> Not compatible</div>
        </div>

        <div class="table-container">
          <table id="packagesTable">
            <thead>
              <tr>
                <th class="sortable sticky-col category-col" data-column="category" tabindex="0" role="button" aria-sort="none">
                  Category
                  <span class="sort-arrows">
                    <span class="sort-arrow up" data-column="category" data-direction="asc"></span>
                    <span class="sort-arrow down" data-column="category" data-direction="desc"></span>
                  </span>
                </th>
                <th class="sortable sticky-col app-col" data-column="name" tabindex="0" role="button" aria-sort="none">
                  Tool
                  <span class="sort-arrows">
                    <span class="sort-arrow up" data-column="name" data-direction="asc"></span>
                    <span class="sort-arrow down" data-column="name" data-direction="desc"></span>
                  </span>
                </th>
                <th class="os-column">Claude</th>
                <th class="os-column">Codex</th>
                <th class="os-column">GitHub Copilot</th>
                <th class="os-column">NPX</th>
              </tr>
            </thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div class="stats">
          <div class="stat-item"><div class="stat-number" id="totalPackages">0</div><div class="stat-label">Total Tools</div></div>
          <div class="stat-item"><div class="stat-number" id="mcpCount">0</div><div class="stat-label">MCP Servers</div></div>
          <div class="stat-item"><div class="stat-number" id="pluginCount">0</div><div class="stat-label">Plugins / Skills</div></div>
        </div>
      </CompatibilityTablePage>
    </div>
  </div>
</VPLayout>

<script>
import '../../scripts/toolbox-installer/agents-app.ts';
import '../../scripts/os-compat/agents-compat.ts';
import '../../scripts/shared/view-toggle.ts';
</script>
