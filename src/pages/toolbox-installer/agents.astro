---
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
const options = [
  { value: 'importPackages', label: '📥 Import Agents (JSON)' },
  { value: 'exportPackages', label: '📤 Export Agents (JSON)' },
];
---
<ToolboxInstallerSection
  title="AI Agents Installer"
  heading="🤖 AI Agents Installer"
  info="Browse MCP servers, plugins, and skills for Claude Code, Codex CLI, and other AI coding agents. Pick the tools you need and copy the ready-to-run install commands."
  searchPlaceholder="Search by name or category"
  options={options}
  showFossToggle={false}
  showFileInput={false}
  useForm={true}
  formId="agentForm"
>
  <div slot="selectors" class="os-selector-container">
    <div class="primary-os-selector">
      <button type="button" class="os-btn active" data-agent="claude"><span class="os-btn-icon" aria-hidden="true">🤖</span> Claude Code</button>
      <button type="button" class="os-btn" data-agent="codex"><span class="os-btn-icon" aria-hidden="true">⌨️</span> Codex CLI</button>
      <button type="button" class="os-btn" data-agent="copilot"><span class="os-btn-icon" aria-hidden="true">💬</span> Copilot CLI</button>
      <button type="button" class="os-btn" data-agent="npx"><span class="os-btn-icon" aria-hidden="true">📦</span> NPX</button>
    </div>
    <div class="page-filter-row filter-chips" role="group" aria-label="Filter by type">
      <button type="button" class="filter-chip active" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="filter-chip" data-filter="mcp" aria-pressed="false">🔌 MCP Servers</button>
      <button type="button" class="filter-chip" data-filter="plugin" aria-pressed="false">🧩 Plugins / Skills</button>
    </div>
  </div>

  <div slot="content">
    <ToolboxResultsContainer
      id="packageContainer"
      showLoadingSpinner={true}
    />
  </div>
</ToolboxInstallerSection>

<script>
import '../../scripts/toolbox-installer/agents-app.ts';
</script>