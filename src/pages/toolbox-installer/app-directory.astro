---
import CompatibilityTablePage from '../../components/CompatibilityTablePage.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<CompatibilityTablePage
  title="Web Directory"
  heading="Web Directory"
  subtitle="Every app in one place — web destinations tagged by which platforms they also reach, and whether they're FOSS."
  installerHref={`${BASE}toolbox/`}
  installerLabel="Back to Toolbox"
  searchPlaceholder="Search category, name, or surface"
  extraStyles={['styles/toolbox-directory.css']}
  pageNote="Everything here runs in the browser — there's no installer; opening the link 'installs' the app in your browser. Tags mark optional native surfaces a destination also ships, and whether it's Free and Open Source."
>
  <div slot="controls" class="page-filter-row filter-chips tag-filter-chips" role="group" aria-label="Filter web destinations by surface">
    <button type="button" class="filter-chip tag-chip-all active" data-tag="all" aria-pressed="true">All</button>
    <button type="button" class="filter-chip tag-chip-web" data-tag="web-only" aria-pressed="false">web app</button>
    <button type="button" class="filter-chip tag-chip-desktop" data-tag="desktop" aria-pressed="false">desktop app</button>
    <button type="button" class="filter-chip tag-chip-mobile" data-tag="mobile" aria-pressed="false">mobile app</button>
    <button type="button" class="filter-chip tag-chip-cross-platform" data-tag="cross-platform" aria-pressed="false">cross-platform</button>
    <button type="button" class="filter-chip tag-chip-foss" data-tag="foss" aria-pressed="false">🌿 FOSS</button>
  </div>

  <div class="directory-related-links">
    <span class="directory-related-label">Extensions:</span>
    <a href={`${BASE}toolbox/browser/#compat`}>🧩 Browser</a>
    <a href={`${BASE}toolbox/vscode/#compat`}>🛠️ VS Code</a>
  </div>

  <div class="table-container">
    <table id="toolboxDirectoryTable" class="toolbox-directory-table">
      <thead>
        <tr>
          <th>Category</th>
          <th>Apps</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <div class="stats" aria-label="Directory stats">
    <div class="stat-item"><div class="stat-number" id="directoryVisibleCount">0</div><div class="stat-label">Visible</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryTotalCount">0</div><div class="stat-label">Total</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryWebOnlyCount">0</div><div class="stat-label">web app</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryDesktopCount">0</div><div class="stat-label">desktop app</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryMobileCount">0</div><div class="stat-label">mobile app</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryCrossPlatformCount">0</div><div class="stat-label">cross-platform</div></div>
    <div class="stat-item"><div class="stat-number" id="directoryFossCount">0</div><div class="stat-label">FOSS</div></div>
  </div>

</CompatibilityTablePage>

<script>
import '../../scripts/toolbox-installer/app-directory.ts';
</script>
