---
import VPLayout from '../../layouts/VPLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlatformNav from '../../components/PlatformNav.astro';
import PlatformViewToggle from '../../components/PlatformViewToggle.astro';
import ToolboxInstallerSection from '../../components/ToolboxInstallerSection.astro';
import ToolboxResultsContainer from '../../components/ToolboxResultsContainer.astro';
import CompatibilityTablePage from '../../components/CompatibilityTablePage.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options = [
  { value: 'exportPackages', label: '📤 Export Libraries (JSON)' },
];
---
<VPLayout title="Library Installer" hasSidebar={false} extraStyles={['styles/generator.css', 'styles/os-compatibility.css', 'styles/lib-installer.css']}>
  <div class="page-wrapper installer-page-wrapper">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}toolbox/`}>Toolbox</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Library Installer</span>
    </nav>
    <PageHeader heading="Library Installer" />
    <PlatformNav current="lib" />
    <PlatformViewToggle compatLabel="Compatibility Table" />

    <div id="installerView">
      <ToolboxInstallerSection
        bare
        title="Library Installer"
        heading="Library Installer"
        info="Search software libraries by language and ecosystem. Select dependencies and copy or export ready-to-use install commands."
        searchPlaceholder="Search libraries by name"
        options={options}
        showFossToggle={false}
        showFileInput={false}
        showInternalToggle={true}
      >
        <div slot="selectors" class="os-selector-container">
          <div class="primary-os-selector" id="langSelector" role="group" aria-label="Select programming language"></div>
          <div class="secondary-os-selector" id="javaToolSelector" style="display:none;" role="group" aria-label="Select Java build tool">
            <button type="button" class="distro-btn active" data-tool="maven">Maven (pom.xml)</button>
            <button type="button" class="distro-btn" data-tool="gradle">Gradle (build.gradle)</button>
          </div>
        </div>

        <ToolboxResultsContainer slot="content" id="libContainer" role="list" ariaLabel="Library categories" />
      </ToolboxInstallerSection>
    </div>

    <div id="compatView" hidden>
      <CompatibilityTablePage
        bare
        title="Library Compatibility"
        heading="📚 Library Compatibility"
        subtitle="Equivalent external libraries by category and programming language."
        installerHref="lib"
        installerLabel="Go to Library Installer"
        searchPlaceholder="Search library or category..."
      >
        <div slot="legend" class="legend" aria-label="Type legend">
          <div class="legend-tools">
            <label for="compatVisibilitySelect" class="compat-filter-label">Libraries:</label>
            <select id="compatVisibilitySelect" class="compat-visibility-select" aria-label="Filter compatibility by library type">
              <option value="external" selected>External only</option>
              <option value="all">All</option>
              <option value="core">Core only</option>
            </select>
          </div>
          <div class="legend-item">
            <span class="compat-badge compat-badge-included" title="Included in language/runtime">core</span>
            Included in standard library or runtime
          </div>
          <div class="legend-item">
            <span class="compat-badge compat-badge-external" title="Requires package manager">ext</span>
            External dependency managed by package manager
          </div>
        </div>

        <div class="table-container">
          <table id="compatTable">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div slot="extra" class="info-note" role="note" aria-label="Note about C and C++">
          <h3>⚠️ Note on C / C++</h3>
          <p>C and C++ are intentionally excluded from this table because:</p>
          <ul>
            <li>They lack a universal, standardized package manager. Tools like <code>Conan</code> or <code>vcpkg</code> exist but are not universally adopted.</li>
            <li>Libraries are typically integrated via compilation flags and manual linking (e.g. <code>-lfoo</code>, CMake <code>find_package()</code>, or <code>pkg-config</code>).</li>
            <li>Dependency management varies significantly by platform, compiler, and build system.</li>
          </ul>
          <p>For these reasons, C/C++ is also excluded from the automatic install command generator.</p>
        </div>
      </CompatibilityTablePage>
    </div>
  </div>
</VPLayout>

<script>
import '../../scripts/toolbox-installer/lib-installer.ts';
import '../../scripts/os-compat/lib-compat.ts';
import '../../scripts/shared/view-toggle.ts';
</script>
