---
import VPLayout from '../layouts/VPLayout.astro';

const BASE = (import.meta as any).env.BASE_URL.replace(/\/?$/, '/');

const toolboxCards = [
  {
    title: 'OS Installer',
    description: 'Get and install desktop operating systems — Windows, macOS, Linux, and FreeBSD.',
    href: `${BASE}toolbox/os/`,
    icon: '💿',
  },
  {
    title: 'Desktop Installer',
    description: 'Install desktop apps with command generation, filters, and favorites.',
    href: `${BASE}toolbox/desktop/`,
    icon: '🖥️',
  },
  {
    title: 'Mobile Installer',
    description: 'Browse mobile packages for Android and iOS workflows.',
    href: `${BASE}toolbox/mobile/`,
    icon: '📱',
  },
  {
    title: 'Library Installer',
    description: 'Search software libraries by ecosystem and export selections.',
    href: `${BASE}toolbox/lib/`,
    icon: '📚',
  },
  {
    title: 'Browser Extensions',
    description: 'Pick browser add-ons for Firefox and Chromium.',
    href: `${BASE}toolbox/browser/`,
    icon: '🧩',
  },
  {
    title: 'VS Code Extensions',
    description: 'Curated editor extensions with import, export, and favorites.',
    href: `${BASE}toolbox/vscode/`,
    icon: '🛠️',
  },
];

const directoryLinks = [
  {
    label: 'App Directory',
    href: `${BASE}toolbox/app-directory/`,
    icon: '🌐',
    description: 'Every app in one place, tagged by which platforms it also reaches and whether it\'s FOSS. No installer needed — opening the link runs the web app in your browser.',
  },
];

const compatibilityLinks = [
  { label: 'Operating System Compatibility', href: `${BASE}toolbox/os-compatibility/`, icon: '💿' },
  { label: 'Desktop App OS Compatibility', href: `${BASE}toolbox/desktop-os-compatibility/`, icon: '🖥️' },
  { label: 'Mobile OS Compatibility', href: `${BASE}toolbox/mobile-os-compatibility/`, icon: '📱' },
  { label: 'Library Compatibility Table', href: `${BASE}toolbox/lib-compatibility/`, icon: '📚' },
  { label: 'Browser Extensions Compatibility', href: `${BASE}toolbox/browser-extensions-compatibility/`, icon: '🧩' },
  { label: 'VS Code Extensions Compatibility', href: `${BASE}toolbox/vscode-extensions-compatibility/`, icon: '🛠️' },
];

// Cross-platform terminal companion — the same toolbox, run from your shell.
// One command per OS family; the page auto-selects based on the visitor's platform.
const TUI_REPO = 'https://github.com/interneto/tui-toolbox-installer';
const tuiInstall = [
  {
    id: 'windows',
    label: 'Windows',
    code: 'irm https://raw.githubusercontent.com/interneto/tui-toolbox-installer/main/scripts/install.ps1 | iex',
  },
  {
    id: 'unix',
    label: 'macOS / Linux',
    code: 'curl -fsSL https://raw.githubusercontent.com/interneto/tui-toolbox-installer/main/scripts/install.sh | sh',
  },
];
---

<VPLayout title="Toolbox" hasSidebar={false} extraStyles={['styles/toolbox-landing.css']}>
  <section class="toolbox-landing">
    <section class="toolbox-hero-shell">
      <div class="toolbox-hero">
        <div>
          <div class="toolbox-eyebrow">Toolbox</div>
          <h1>Toolbox</h1>
          <p>One home for installers, an app directory, and compatibility references — all running straight in the browser.</p>
        </div>
      </div>
    </section>

    <section class="toolbox-section">
      <div class="toolbox-section-header">
        <h2>Installers</h2>
        <p>Choose the installer surface you want to work with.</p>
      </div>
      <div class="toolbox-grid">
        {toolboxCards.map((card) => (
          <a class="toolbox-card" href={card.href}>
            <span class="toolbox-card-icon">{card.icon}</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </a>
        ))}
      </div>

      <div class="toolbox-tui">
        <p class="toolbox-tui-intro">
          Prefer the terminal? Run the cross-platform <strong>TUI installer</strong> — it
          autodetects your system, lets you multi-select packages just like this site, and
          installs them for real.
          <a class="toolbox-tui-repo" href={TUI_REPO} target="_blank" rel="noreferrer">View on GitHub ↗</a>
        </p>

        <div class="toolbox-tui-os-toggle" role="group" aria-label="Choose your OS">
          {tuiInstall.map((cmd, i) => (
            <button type="button" class="tui-os-btn" data-os={cmd.id} aria-pressed={i === 0 ? 'true' : 'false'}>{cmd.label}</button>
          ))}
        </div>

        <div class="tb-cmd">
          <div class="tb-cmd-row">
            {tuiInstall.map((cmd, i) => (
              <code class="tui-os-cmd" data-os={cmd.id} hidden={i !== 0}>{cmd.code}</code>
            ))}
            <button type="button" id="tuiCopyBtn" class="tb-copy" aria-label="Copy install command">Copy</button>
          </div>
        </div>
      </div>
    </section>

    <div class="toolbox-separator" aria-hidden="true"></div>

    <section class="toolbox-section">
      <div class="toolbox-section-header">
        <h2>App Directory</h2>
        <p>Web apps, platforms, and databases — tagged by which platforms they also reach.</p>
      </div>
      <div class="toolbox-grid">
        {directoryLinks.map((item) => (
          <a class="toolbox-card" href={item.href}>
            <span class="toolbox-card-icon">{item.icon}</span>
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <div class="toolbox-separator" aria-hidden="true"></div>

    <section class="toolbox-section">
      <div class="toolbox-section-header">
        <h2>Compatibility Tables</h2>
        <p>Compare availability and support before jumping into each installer.</p>
      </div>
      <div class="toolbox-compatibility-grid">
        {compatibilityLinks.map((item) => (
          <a class="toolbox-compatibility-link" href={item.href}>
            <span class="toolbox-card-icon">{item.icon}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </section>
  </section>

  <script>
    // Auto-detect Windows vs macOS/Linux, but let the visitor override.
    const osButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tui-os-btn'));
    const osCommands = Array.from(document.querySelectorAll<HTMLElement>('.tui-os-cmd'));

    function setOS(os: string) {
      osButtons.forEach((btn) => {
        const active = btn.dataset.os === os;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      osCommands.forEach((el) => {
        el.hidden = el.dataset.os !== os;
      });
    }

    osButtons.forEach((btn) => {
      btn.addEventListener('click', () => setOS(btn.dataset.os ?? 'unix'));
    });

    if (osButtons.length) {
      const isWindows = navigator.userAgent.toLowerCase().includes('win');
      setOS(isWindows ? 'windows' : 'unix');
    }

    const copyBtn = document.getElementById('tuiCopyBtn');
    copyBtn?.addEventListener('click', async () => {
      const visible = osCommands.find((el) => !el.hidden);
      const code = visible?.textContent;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        copyBtn.classList.add('is-copied');
        setTimeout(() => {
          copyBtn.textContent = original;
          copyBtn.classList.remove('is-copied');
        }, 1500);
      } catch (_) {
        /* clipboard unavailable */
      }
    });
  </script>
</VPLayout>

