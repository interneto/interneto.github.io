---
import { getCollection, render } from 'astro:content';
import VPLayout from '../../layouts/VPLayout.astro';
import ContentTOC from '../../components/ContentTOC.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((entry) => entry.id.replace(/\.md$/i, '') !== 'index')
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.md$/i, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageTitle = entry.data.title ?? entry.id;
const hasLeadingMarkdownTitle = /^\s*#\s+/.test(entry.body ?? '');
const tags = entry.data.tags ?? [];
---

<VPLayout title={pageTitle} hasSidebar={true} extraStyles={['styles/content-shared.css', 'styles/posts-page.css']}>
  <div class="vp-post-wrapper">
    <nav class="vp-breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}`}>Home</a>
      <span class="vp-breadcrumb-sep">›</span>
      <a href={`${BASE}blog/`}>Blog</a>
      <span class="vp-breadcrumb-sep">›</span>
      <span>{pageTitle}</span>
    </nav>

    <article class="vp-post-content">
      {!hasLeadingMarkdownTitle && (
        <header class="vp-post-header">
          <h1>{pageTitle}</h1>
          {entry.data.description && <p class="vp-post-lead">{entry.data.description}</p>}
          {tags.length > 0 && (
            <ul class="vp-post-tags" aria-label="Tags">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>
      )}
      <div class="vp-prose">
        <Content />
      </div>
    </article>

    <ContentTOC headings={headings} />
  </div>
</VPLayout>
