---
import { getCollection } from 'astro:content';
import VPLayout from '../../layouts/VPLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allDocs = await getCollection('categories');
const cleanSlug = (id: string) => id.replace(/\.md$/i, '');
const HIDDEN_CATEGORY_PATTERN = /nsfw(?:-content)?/i;

const categoryIcons: Record<string, string> = {
  'by-company': '🏢',
  'os': '🐧',
  'ai-tools-and-services': '🧰',
  'dev': '⌨️',
  'gaming': '🎮',
  'education': '🎓',
  'file-management': '📁',
  'financial-assets': '💰',
  'health-and-fitness': '❤️',
  'home-and-family': '🏠',
  'intercomm': '☎️',
  'multimedia': '📺',
  'news-media': '📰',
  'office-and-productivity': '💼',
  'online-services': '🌐',
  'security-and-privacy': '🛡️',
  'sys-admin': '💻',
  'time': '🕐',
  'travel-and-location': '🛬',
  'utility': '🔧',
};

const customOrder = [
  'by-company', 'os', 'ai-tools-and-services', 'dev', 'gaming',
  'education', 'file-management', 'financial-assets', 'health-and-fitness',
  'home-and-family', 'intercomm', 'multimedia', 'news-media',
  'office-and-productivity', 'online-services', 'security-and-privacy',
  'sys-admin', 'time', 'travel-and-location', 'utility'
];

const docs = allDocs
  .filter((entry) => {
    const slug = cleanSlug(entry.id);
    if (['about', 'index'].includes(slug)) return false;
    return !HIDDEN_CATEGORY_PATTERN.test(slug);
  })
  .sort((a, b) => customOrder.indexOf(cleanSlug(a.id)) - customOrder.indexOf(cleanSlug(b.id)));
---

<VPLayout title="Categories" hasSidebar={true} extraStyles={['styles/content-shared.css']}>
  <div class="vp-content-wrapper">
    <header class="vp-content-header">
      <h1>Categories</h1>
      <p class="vp-content-subtitle">Comprehensive link directory organized by category with curated resources and tools.</p>
    </header>

    <section class="vp-content-grid" aria-label="Categories index">
      {docs.map((entry) => {
        const slug = cleanSlug(entry.id);
        return (
          <ContentCard
            href={`${BASE}categories/${slug}/`}
            title={entry.data.title ?? slug}
            description={entry.data.description ?? ''}
            icon={categoryIcons[slug] ?? '📚'}
          />
        );
      })}
    </section>
  </div>
</VPLayout>
