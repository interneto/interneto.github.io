---
import { getCollection } from 'astro:content';
import VPLayout from '../../layouts/VPLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import Icon from '../../components/Icon.astro';
import bookmarks from '../../../public/generated/bookmarks.json';
import taxonomy from '../../../public/pkgs/taxonomy.json';
import { formatCount } from '../../lib/format-count';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const countByCategory: Record<string, number> = {};
for (const b of bookmarks) {
  countByCategory[b.category] = (countByCategory[b.category] ?? 0) + 1;
}

const MAX_SUBCATEGORIES = 2;
const subcategoriesByCategory: Record<string, string[]> = {};
for (const c of taxonomy.categories) {
  const subs = c.subcategories?.length ? c.subcategories : (c.children?.map((ch) => ch.name) ?? []);
  subcategoriesByCategory[c.id] =
    subs.length > MAX_SUBCATEGORIES
      ? [...subs.slice(0, MAX_SUBCATEGORIES), `+${subs.length - MAX_SUBCATEGORIES} more`]
      : subs;
}

const allDocs = await getCollection('categories');
const cleanSlug = (id: string) => id.replace(/\.md$/i, '');
const HIDDEN_CATEGORY_PATTERN = /nsfw(?:-content)?/i;

const categoryIcons: Record<string, string> = {
  'ai-tools-and-services': '🤖',
  'business-and-commerce': '🏪',
  'development': '💻',
  'education-and-reference': '📚',
  'file-management': '📁',
  'gaming': '🎮',
  'health-and-fitness': '💪',
  'home-and-family': '🏠',
  'money-and-finance': '💰',
  'multimedia': '🎬',
  'news-and-books': '📰',
  'office-and-productivity': '📊',
  'online-services': '🌐',
  'os-and-utilities': '⚙️',
  'security-and-privacy': '🔒',
  'social-and-communications': '💬',
  'system-administration': '🖥️',
  'travel-and-location': '✈️',
  'web-browsers': '🌍',
};

const customOrder = [
  'ai-tools-and-services', 'business-and-commerce',
  'development', 'education-and-reference', 'file-management',
  'gaming', 'health-and-fitness', 'home-and-family',
  'money-and-finance', 'multimedia', 'news-and-books',
  'office-and-productivity', 'online-services', 'os-and-utilities',
  'security-and-privacy', 'social-and-communications',
  'system-administration', 'travel-and-location', 'web-browsers'
];

const docs = allDocs
  .filter((entry) => {
    const slug = cleanSlug(entry.id);
    if (['about', 'index'].includes(slug)) return false;
    return !HIDDEN_CATEGORY_PATTERN.test(slug);
  })
  .sort((a, b) => customOrder.indexOf(cleanSlug(a.id)) - customOrder.indexOf(cleanSlug(b.id)));
---

<VPLayout title="Categories" hasSidebar={true} extraStyles={['styles/content-shared.css', 'styles/categories-index.css']}>
  <div class="vp-content-wrapper">
    <header class="vp-content-header">
      <h1>Categories</h1>
      <p class="vp-content-subtitle">Comprehensive web directory organized by category with curated resources and tools.</p>
    </header>

    <button type="button" id="siteLinkSearchTrigger" class="vp-site-search-trigger">
      <Icon name="search" class="vp-site-search-trigger-icon" />
      <span>Search all links…</span>
      <kbd class="vp-site-search-kbd">Ctrl K</kbd>
    </button>

    <div id="siteLinkSearchModal" class="vp-site-search-modal" hidden>
      <div class="vp-site-search-dialog" role="dialog" aria-modal="true" aria-label="Search all links">
        <div class="vp-site-search-input-row">
          <Icon name="search" class="vp-site-search-input-icon" />
          <input
            id="siteLinkSearch"
            class="vp-site-search-input"
            type="search"
            placeholder="Search all links…"
            autocomplete="off"
            aria-label="Search all links"
          />
          <button type="button" id="siteLinkSearchClose" class="vp-site-search-close" aria-label="Close search">✕</button>
        </div>

        <p class="vp-site-search-count" id="siteLinkSearchCount" aria-live="polite" hidden></p>
        <ul class="vp-site-search-results" id="siteLinkSearchResults" aria-label="Link search results" hidden></ul>
        <p class="vp-content-empty" id="siteLinkSearchEmpty" hidden>No links match your search.</p>

        <div class="vp-site-search-hints">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>Enter</kbd> select</span>
          <span><kbd>Esc</kbd> close</span>
        </div>
      </div>
    </div>

    <section class="vp-content-grid vp-categories-index" aria-label="Categories index">
      {docs.map((entry) => {
        const slug = cleanSlug(entry.id);
        return (
          <ContentCard
            href={`${BASE}categories/${slug}/`}
            title={entry.data.title ?? slug}
            description={entry.data.description ?? ''}
            icon={categoryIcons[slug] ?? '📚'}
            count={`${formatCount(countByCategory[slug] ?? 0)} links`}
            tags={subcategoriesByCategory[slug] ?? []}
          />
        );
      })}
    </section>
  </div>

  <script is:inline type="application/json" id="categoryMetaData" set:html={JSON.stringify(
    Object.fromEntries(docs.map((entry) => {
      const slug = cleanSlug(entry.id);
      return [slug, { title: entry.data.title ?? slug, icon: categoryIcons[slug] ?? '📚' }];
    }))
  )} />
  <script>import '../../scripts/categories/link-search';</script>
</VPLayout>
