---
import { getCollection, render } from 'astro:content';
import VPLayout from '../../layouts/VPLayout.astro';
import ContentTOC from '../../components/ContentTOC.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

export async function getStaticPaths() {
  const docs = await getCollection('categories');
  return docs
    .filter((entry) => {
      const slug = entry.id.replace(/\.md$/i, '');
      return !['about', 'index'].includes(slug);
    })
    .map((entry) => ({
      params: { slug: entry.id.replace(/\.md$/i, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageTitle = entry.data.title ?? entry.id;
const hasLeadingMarkdownTitle = /^\s*#\s+/.test(entry.body ?? '');
---

<VPLayout title={pageTitle} hasSidebar={true} extraStyles={['styles/content-shared.css', 'styles/categories-page.css']}>
  <div class="vp-post-wrapper">
    <nav class="vp-breadcrumb" aria-label="Breadcrumb">
      <a href={`${BASE}`}>Home</a>
      <span class="vp-breadcrumb-sep">›</span>
      <a href={`${BASE}categories/`}>Categories</a>
      <span class="vp-breadcrumb-sep">›</span>
      <span>{pageTitle}</span>
    </nav>

    <article class="vp-post-content">
      {!hasLeadingMarkdownTitle && (
        <header class="vp-post-header">
          <h1>{pageTitle}</h1>
        </header>
      )}

      <div class="vp-link-filter">
        <input
          id="categoryLinkSearch"
          class="vp-link-filter-input"
          type="search"
          placeholder="Search links in this category"
          autocomplete="off"
          aria-label="Search links in this category"
        />
        <span id="categoryLinkFilterCount" class="vp-link-filter-count" aria-live="polite"></span>
      </div>

      <div class="vp-prose">
        <Content />
      </div>
      <p class="vp-content-empty" id="categoryLinkFilterEmpty" hidden>No links match your filters.</p>
    </article>

    <ContentTOC headings={headings} />
  </div>

  <script is:inline>
    (() => {
      const toggle = document.getElementById('categoryFavoritesToggle');
      const searchInput = document.getElementById('categoryLinkSearch');
      const countEl = document.getElementById('categoryLinkFilterCount');
      const emptyEl = document.getElementById('categoryLinkFilterEmpty');
      const prose = document.querySelector('.vp-prose');
      if (!prose) return;

      const STORAGE_KEY = 'interneto:favorites-only';
      const STAR_RE = /^\s*⭐/;
      const normalize = (v) => v.trim().toLowerCase();

      const items = Array.from(prose.querySelectorAll('li'));
      const favItems = new Set(items.filter((li) => STAR_RE.test(li.textContent || '')));
      const lists = Array.from(prose.querySelectorAll('ul, ol'));
      const headings = Array.from(prose.querySelectorAll('h2, h3, h4'));

      // Hidden by either the favorites-only toggle or the search box below.
      const isVisible = (el) => !el.classList.contains('vp-favorite-hidden');

      let favOnly = false;
      let query = '';

      const apply = () => {
        const q = normalize(query);
        let visibleCount = 0;

        items.forEach((li) => {
          const visible = (!favOnly || favItems.has(li)) && (!q || normalize(li.textContent || '').includes(q));
          li.classList.toggle('vp-favorite-hidden', !visible);
          if (visible) visibleCount += 1;
        });

        lists.forEach((list) => {
          const hasVisibleChild = Array.from(list.children).some(isVisible);
          list.classList.toggle('vp-favorite-hidden', !hasVisibleChild);
        });

        headings.forEach((h) => {
          let sibling = h.nextElementSibling;
          let hasContent = false;
          while (sibling && !/^H[2-4]$/.test(sibling.tagName)) {
            if (isVisible(sibling) && (sibling.tagName === 'UL' || sibling.tagName === 'OL' || sibling.textContent?.trim())) {
              hasContent = true;
              break;
            }
            sibling = sibling.nextElementSibling;
          }
          h.classList.toggle('vp-favorite-hidden', !hasContent);
        });

        if (countEl) {
          countEl.textContent =
            favOnly || q ? `${visibleCount} of ${items.length} shown` : `${items.length} links`;
        }
        if (emptyEl) emptyEl.hidden = visibleCount > 0;
      };

      if (toggle) {
        try {
          favOnly = localStorage.getItem(STORAGE_KEY) === '1';
        } catch {}
        toggle.setAttribute('aria-checked', favOnly ? 'true' : 'false');
        toggle.classList.toggle('is-active', favOnly);

        toggle.addEventListener('click', () => {
          favOnly = !favOnly;
          try {
            localStorage.setItem(STORAGE_KEY, favOnly ? '1' : '0');
          } catch {}
          toggle.setAttribute('aria-checked', favOnly ? 'true' : 'false');
          toggle.classList.toggle('is-active', favOnly);
          apply();
        });
      }

      if (searchInput instanceof HTMLInputElement) {
        let debounce;
        searchInput.addEventListener('input', () => {
          clearTimeout(debounce);
          // Debounced: each run walks every li/list/heading in the category (up to ~5k on the big ones).
          debounce = setTimeout(() => {
            query = searchInput.value;
            apply();
          }, 120);
        });
      }

      apply();
    })();
  </script>
</VPLayout>
