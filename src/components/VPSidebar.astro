---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { POST_SECTIONS } from '../data/posts';

interface SidebarItem {
  text: string;
  href: string;
  icon?: IconName;
  isActive: boolean;
}

interface SidebarSection {
  title: string;
  items: SidebarItem[];
}

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const isPathActive = (link: string): boolean => {
  return currentPath.startsWith(link) || currentPath === link;
};

// Build category items (used on /categories/ index only)
const categoryItems: SidebarItem[] = [
  { text: '🤖 AI Tools & Services', href: `${BASE}categories/ai-tools-and-services/`, isActive: isPathActive(`${BASE}categories/ai-tools-and-services/`) },
  { text: '� Business & Commerce', href: `${BASE}categories/business-and-commerce/`, isActive: isPathActive(`${BASE}categories/business-and-commerce/`) },
  { text: '💻 Development', href: `${BASE}categories/development/`, isActive: isPathActive(`${BASE}categories/development/`) },
  { text: '📚 Education & Reference', href: `${BASE}categories/education-and-reference/`, isActive: isPathActive(`${BASE}categories/education-and-reference/`) },
  { text: '📁 File Management', href: `${BASE}categories/file-management/`, isActive: isPathActive(`${BASE}categories/file-management/`) },
  { text: '🎮 Gaming', href: `${BASE}categories/gaming/`, isActive: isPathActive(`${BASE}categories/gaming/`) },
  { text: '💪 Health & Fitness', href: `${BASE}categories/health-and-fitness/`, isActive: isPathActive(`${BASE}categories/health-and-fitness/`) },
  { text: '🏠 Home & Family', href: `${BASE}categories/home-and-family/`, isActive: isPathActive(`${BASE}categories/home-and-family/`) },
  { text: '💰 Money & Finance', href: `${BASE}categories/money-and-finance/`, isActive: isPathActive(`${BASE}categories/money-and-finance/`) },
  { text: '🎬 Multimedia', href: `${BASE}categories/multimedia/`, isActive: isPathActive(`${BASE}categories/multimedia/`) },
  { text: '📰 News & Books', href: `${BASE}categories/news-and-books/`, isActive: isPathActive(`${BASE}categories/news-and-books/`) },
  { text: '📊 Office & Productivity', href: `${BASE}categories/office-and-productivity/`, isActive: isPathActive(`${BASE}categories/office-and-productivity/`) },
  { text: '🌐 Online Services', href: `${BASE}categories/online-services/`, isActive: isPathActive(`${BASE}categories/online-services/`) },
  { text: '⚙️ OS & Utilities', href: `${BASE}categories/os-and-utilities/`, isActive: isPathActive(`${BASE}categories/os-and-utilities/`) },
  { text: '🔒 Security & Privacy', href: `${BASE}categories/security-and-privacy/`, isActive: isPathActive(`${BASE}categories/security-and-privacy/`) },
  { text: '💬 Social & Communications', href: `${BASE}categories/social-and-communications/`, isActive: isPathActive(`${BASE}categories/social-and-communications/`) },
  { text: '🖥️ System Administration', href: `${BASE}categories/system-administration/`, isActive: isPathActive(`${BASE}categories/system-administration/`) },
  { text: '✈️ Travel & Location', href: `${BASE}categories/travel-and-location/`, isActive: isPathActive(`${BASE}categories/travel-and-location/`) },
  { text: '🌍 Web Browsers', href: `${BASE}categories/web-browsers/`, isActive: isPathActive(`${BASE}categories/web-browsers/`) },
];

const postSections: SidebarSection[] = POST_SECTIONS.map((section) => ({
  title: section.title,
  items: section.items.map((item) => ({
    text: item.text,
    href: `${BASE}blog/${item.slug}/`,
    icon: (item.icon ?? 'posts') as IconName,
    isActive: isPathActive(`${BASE}blog/${item.slug}/`),
  })),
}));

const mapItems: SidebarItem[] = [
  { text: 'Open Dashboard', href: `${BASE}map/`, icon: 'map', isActive: isPathActive(`${BASE}map/`) },
  { text: 'Classic View', href: `${BASE}map/?view=classic`, icon: 'map', isActive: false },
  { text: 'Semantic View', href: `${BASE}map/?view=semantic`, icon: 'map', isActive: false },
  { text: 'Geo View', href: `${BASE}map/?view=geo`, icon: 'map', isActive: false },
  { text: 'Blog', href: `${BASE}blog/`, icon: 'posts', isActive: false },
  { text: 'Categories', href: `${BASE}categories/`, icon: 'categories', isActive: false },
];

// Left sidebar on /categories/ + /categories/<slug>, /blog/ + /post/<slug>, and /map/
const isCategoriesArea = currentPath.startsWith(`${BASE}categories`);
const isCategoryDetail = isCategoriesArea && currentPath !== `${BASE}categories` && currentPath !== `${BASE}categories/`;
const isPostsArea = currentPath.startsWith(`${BASE}blog`);
const isMapPage = currentPath.includes('/map');

const sidebarKind: 'categories' | 'posts' | 'map' | 'none' =
  isCategoriesArea ? 'categories' :
  isPostsArea ? 'posts' :
  isMapPage ? 'map' : 'none';

const title =
  sidebarKind === 'categories' ? 'Categories' :
  sidebarKind === 'posts' ? 'Blog' :
  sidebarKind === 'map' ? 'Link Dashboard' : '';
---

{sidebarKind !== 'none' && (
  <aside id="vpSidebar" class="vp-sidebar" aria-hidden="false">
    <div class="vp-sidebar-content">
      <nav class="vp-sidebar-nav">
        <div class="vp-sidebar-title">{title}</div>

        {sidebarKind === 'categories' && (
          <div class="vp-sidebar-search-wrap">
            <input
              id="categorySidebarSearch"
              class="vp-sidebar-search-input"
              type="search"
              placeholder="Search categories"
              autocomplete="off"
              aria-label="Search categories"
            />
          </div>
        )}

        {isCategoryDetail && (
          <div class="vp-sidebar-favorites-wrap">
            <button
              id="categoryFavoritesToggle"
              type="button"
              class="vp-favorites-switch"
              role="switch"
              aria-checked="false"
              aria-label="Show only favorite links"
            >
              <span class="vp-favorites-switch-track" aria-hidden="true">
                <span class="vp-favorites-switch-thumb"></span>
              </span>
              <span class="vp-favorites-switch-label">
                <span class="vp-favorites-switch-star" aria-hidden="true">★</span>
                Favorites
              </span>
            </button>
          </div>
        )}

        {sidebarKind === 'posts' && (
          <div class="vp-sidebar-search-wrap">
            <input
              id="postsSidebarSearch"
              class="vp-sidebar-search-input"
              type="search"
              placeholder="Search posts"
              autocomplete="off"
              aria-label="Search posts"
            />
          </div>
        )}

        {sidebarKind === 'posts' ? (
          postSections.map((section) => (
            <div class="vp-sidebar-section">
              <div class="vp-sidebar-section-title">{section.title}</div>
              <div class="vp-sidebar-items">
                {section.items.map((item) => (
                  <a
                    class={`vp-sidebar-item-link ${item.isActive ? 'active' : ''}`}
                    href={item.href}
                  >
                    <span class="vp-sidebar-item-content">
                      <Icon name={item.icon ?? 'posts'} class="vp-sidebar-link-icon" />
                      <span>{item.text}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))
        ) : (
          <div class="vp-sidebar-items">
            {(sidebarKind === 'categories' ? categoryItems : mapItems).map((item) => (
              <a
                class={`vp-sidebar-item-link ${item.isActive ? 'active' : ''}`}
                href={item.href}
              >
                <span class="vp-sidebar-item-content">
                  {item.icon && <Icon name={item.icon} class="vp-sidebar-link-icon" />}
                  <span>{item.text}</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
  </aside>
)}

<script>
  const normalize = (value: string) => value.trim().toLowerCase();

  const wireSidebarSearch = (inputId: string) => {
    const input = document.getElementById(inputId);
    if (!(input instanceof HTMLInputElement)) return;
    const sidebar = document.getElementById('vpSidebar');
    if (!sidebar) return;
    const links = Array.from(sidebar.querySelectorAll('.vp-sidebar-item-link'));
    const sections = Array.from(sidebar.querySelectorAll('.vp-sidebar-section'));

    const apply = (query: string) => {
      const q = normalize(query);
      links.forEach((link) => {
        const label = normalize(link.textContent || '');
        const visible = q === '' || label.includes(q);
        link.classList.toggle('vp-sidebar-search-hidden', !visible);
      });
      sections.forEach((section) => {
        const hasVisible = Array.from(section.querySelectorAll('.vp-sidebar-item-link'))
          .some((l) => !l.classList.contains('vp-sidebar-search-hidden'));
        section.classList.toggle('vp-sidebar-search-hidden', !hasVisible);
      });
    };

    input.addEventListener('input', () => apply(input.value));
  };

  wireSidebarSearch('categorySidebarSearch');
  wireSidebarSearch('postsSidebarSearch');
</script>
