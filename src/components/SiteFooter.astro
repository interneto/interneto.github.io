---
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---
<footer id="siteFooter" class="site-footer">
  <span>© {year} <a href="https://github.com/interneto/interneto.github.io" target="_blank" rel="noopener">Interneto</a></span>
  <span class="site-footer-sep" aria-hidden="true">•</span>
  <span>Made with ❤️ and <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></span>
  <span class="site-footer-sep" aria-hidden="true">•</span>
  <span class="site-footer-social">
    <a href="https://interneto.raindrop.page/" target="_blank" rel="noopener" aria-label="Raindrop" title="Raindrop">
      <img src={`${BASE}img/software/apps/raindrop-io.svg`} alt="Raindrop" width="16" height="16" loading="lazy" />
    </a>
    <a href="https://github.com/interneto/interneto.github.io" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
      <img class="site-footer-icon-github" src={`${BASE}img/software/apps/github.svg`} alt="GitHub" width="16" height="16" loading="lazy" />
    </a>
  </span>
</footer>
